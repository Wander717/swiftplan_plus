<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.demo3.controller.AuditLogController"
            stylesheets="@style.css">

    <top>
        <VBox spacing="10">
            <Label text="Histórico de Atividades" styleClass="page-title" style="-fx-padding: 12 16;" />

            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 16 8 16;">
                <TextField fx:id="tfBusca" promptText="Buscar por descrição ou usuário..." prefWidth="360" />
                <Label text="Ação:" />
                <ComboBox fx:id="cbAcao" prefWidth="140" />
                <Button text="Atualizar" onAction="#handleAtualizar" />
                <Label fx:id="lblTotal" styleClass="text-muted" />
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tabelaAuditoria">
            <columns>
                <TableColumn fx:id="colDataHora" text="Data e hora" prefWidth="150" />
                <TableColumn fx:id="colUsuario" text="Usuário" prefWidth="180" />
                <TableColumn fx:id="colPerfil" text="Perfil" prefWidth="80" />
                <TableColumn fx:id="colAcao" text="Ação" prefWidth="90" />
                <TableColumn fx:id="colDescricao" text="Descrição" prefWidth="620" />
            </columns>
        </TableView>
    </center>

    <padding><Insets bottom="12" left="16" right="16" top="0" /></padding>

</BorderPane>
